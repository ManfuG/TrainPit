rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function identifier(value) { return value is string && value.size() > 0 && value.size() <= 128; }
    function profile(uid) { return get(/databases/$(database)/documents/profiles/$(uid)).data; }
    function hasRole(uid, role) { return profile(uid).role == role; }
    function relationship(trainer, client) {
      return get(/databases/$(database)/documents/relationships/$(trainer + '_' + client)).data;
    }
    function active(trainer, client) { return relationship(trainer, client).status == 'ACTIVE'; }
    function weightConsent(trainer, client) {
      return active(trainer, client) && relationship(trainer, client).shareBodyWeight == true;
    }
    function boundedQuery() { return request.query.limit != null && request.query.limit <= 200; }
    function validParents(parents, revisionId) {
      return parents is list && parents.size() <= 100
        && parents.toSet().size() == parents.size() && !(revisionId in parents)
        && (parents.size() == 0 || (
          parents.join('/').matches('[^/]{1,128}(/[^/]{1,128}){0,99}')
          && parents == parents.join('/').split('/')
        ));
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'role'])
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'role'])
        && identifier(uid) && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100
        && request.resource.data.role in ['TRAINER', 'CLIENT'];
      allow update, delete: if false;

      match /devices/{deviceId} {
        allow get, list: if signedIn();
        allow create: if owns(uid) && exists(/databases/$(database)/documents/profiles/$(uid))
          && request.resource.data.keys().hasAll(['ownerId', 'deviceId', 'publicKey', 'revoked'])
          && request.resource.data.keys().hasOnly(['ownerId', 'deviceId', 'publicKey', 'revoked'])
          && request.resource.data.ownerId == uid && request.resource.data.deviceId == deviceId
          && identifier(deviceId) && request.resource.data.revoked == false
          && request.resource.data.publicKey is string
          && request.resource.data.publicKey.size() >= 120 && request.resource.data.publicKey.size() <= 256
          && request.resource.data.publicKey.matches('[A-Za-z0-9+/]+={0,2}');
        allow update: if owns(uid) && resource.data.revoked == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true;
        allow delete: if false;
      }

      match /entries/{revisionId} {
        function canRead() {
          return owns(uid) || (signedIn() && (
            (resource.data.kind == 'PLAN' && resource.data.subjectId == request.auth.uid
              && active(uid, request.auth.uid))
            || (resource.data.kind == 'SESSION' && active(request.auth.uid, uid))
            || (resource.data.kind == 'WEIGHT' && weightConsent(request.auth.uid, uid))
          ));
        }
        function validEntry() {
          let d = request.resource.data;
          let key = get(/databases/$(database)/documents/profiles/$(uid)/devices/$(d.deviceId)).data;
          return d.keys().hasAll(['ownerId', 'subjectId', 'kind', 'rootId', 'deviceId', 'parents', 'createdAt', 'deleted', 'payload', 'serverAt'])
            && d.keys().hasOnly(['ownerId', 'subjectId', 'kind', 'rootId', 'deviceId', 'parents', 'createdAt', 'deleted', 'payload', 'serverAt'])
            && d.ownerId == uid && identifier(revisionId) && identifier(d.subjectId)
            && identifier(d.rootId) && identifier(d.deviceId)
            && key.ownerId == uid && key.deviceId == d.deviceId && key.revoked == false
            && validParents(d.parents, revisionId)
            && d.createdAt is int && d.createdAt >= 0 && d.createdAt <= 253402300799999
            && d.deleted is bool && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 262144
            && d.serverAt is timestamp && d.serverAt == request.time
            && ((d.kind == 'PLAN' && hasRole(uid, 'TRAINER') && active(uid, d.subjectId))
              || (d.kind in ['SESSION', 'WEIGHT'] && hasRole(uid, 'CLIENT') && d.subjectId == uid));
        }
        allow get: if canRead();
        allow list: if boundedQuery() && canRead();
        allow create: if owns(uid) && validEntry();
        allow update, delete: if false;
      }
    }

    match /relationships/{id} {
      function validRelationship() {
        let d = request.resource.data;
        return d.keys().hasAll(['id', 'trainerId', 'clientId', 'trainerName', 'clientName', 'members', 'status', 'shareBodyWeight'])
          && d.keys().hasOnly(['id', 'trainerId', 'clientId', 'trainerName', 'clientName', 'members', 'status', 'shareBodyWeight'])
          && identifier(d.trainerId) && identifier(d.clientId) && d.trainerId != d.clientId
          && d.id == id && id == d.trainerId + '_' + d.clientId
          && d.members == [d.trainerId, d.clientId]
          && hasRole(d.trainerId, 'TRAINER') && hasRole(d.clientId, 'CLIENT')
          && d.trainerName == profile(d.trainerId).displayName
          && d.clientName == profile(d.clientId).displayName
          && d.status in ['PENDING', 'ACTIVE', 'ENDED'] && d.shareBodyWeight is bool;
      }
      function member() { return signedIn() && request.auth.uid in resource.data.members; }
      allow get, list: if member();
      allow create: if signedIn() && validRelationship()
        && request.auth.uid == request.resource.data.trainerId
        && request.resource.data.status == 'PENDING' && request.resource.data.shareBodyWeight == false;
      allow update: if member() && validRelationship()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shareBodyWeight'])
        && (
          (resource.data.status == 'PENDING' && request.auth.uid == resource.data.clientId
            && request.resource.data.status == 'ACTIVE' && request.resource.data.shareBodyWeight == false)
          || (resource.data.status in ['PENDING', 'ACTIVE'] && request.resource.data.status == 'ENDED'
            && request.resource.data.shareBodyWeight == false)
          || (resource.data.status == 'ACTIVE' && request.auth.uid == resource.data.clientId
            && request.resource.data.status == 'ACTIVE')
          || (resource.data.status == 'ENDED' && request.auth.uid == resource.data.trainerId
            && request.resource.data.status == 'PENDING' && request.resource.data.shareBodyWeight == false)
        );
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
